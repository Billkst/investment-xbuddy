# Shared service: maintainer creates an official Groq key; visitors need no account.
# Store the hosted key as a server-side secret, never in frontend code.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Financial data key is separate from the model key.
FUYAO_API_KEY=
# Separate iFinD MCP credential from https://mcp.51ifind.com/
IFIND_MCP_API_KEY=
# Compression trigger in JavaScript characters; NOT the model token window.
CONTEXT_LIMIT=16000
# Site-level protective quotas, independent of provider account limits.
SHARED_MODEL_DAILY_CALLS=40
SHARED_MODEL_DAILY_TOKENS=180000
SHARED_MODEL_MINUTE_CALLS=6
SHARED_MODEL_WORKSPACE_DAILY_CALLS=20
